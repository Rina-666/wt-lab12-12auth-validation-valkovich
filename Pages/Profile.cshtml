@page
@model wt_lab12_12auth_validation_valkovich.Pages.ProfileModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<style>
    .profile-coquette-text {
        color: var(--coq-pink-deep, #c2185b);
    }

    .profile-coquette-subtext {
        color: var(--coq-pink-deep, #c2185b);
        opacity: 0.8;
    }

    .profile-coquette-avatar-placeholder {
        color: var(--coq-pink-deep, #c2185b);
        background-color: rgba(255, 182, 193, 0.22);
        border-color: rgba(194, 24, 91, 0.25) !important;
    }

    .profile-coquette-btn {
        color: var(--coq-pink-deep, #c2185b);
        border-color: var(--coq-pink-deep, #c2185b);
        background-color: transparent;
    }

        .profile-coquette-btn:hover {
            color: #fff;
            background-color: var(--coq-pink-deep, #c2185b);
            border-color: var(--coq-pink-deep, #c2185b);
        }
</style>

<div class="container py-4">
    <div class="card shadow-sm rounded-4 mx-auto" style="max-width: 560px;">
        <div class="card-body p-4 p-md-5">
            <h1 class="mb-4 text-center profile-coquette-text" style="font-family: 'Dancing Script', cursive;">
                Личный кабинет
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
            <div class="alert alert-success rounded-3" role="alert">
                @Model.StatusMessage
            </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
            <div class="alert alert-danger rounded-3" role="alert">
                @Model.ErrorMessage
            </div>
            }

            <div class="d-flex flex-column align-items-center text-center mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
                {
                <img src="@Model.AvatarPath"
                     alt="Фото пользователя @Model.UserLogin"
                     class="rounded-circle object-fit-cover border mb-3"
                     style="width: 128px; height: 128px;" />
                }
                else
                {
                <div class="rounded-circle d-flex align-items-center justify-content-center border profile-coquette-avatar-placeholder mb-3"
                     style="width: 128px; height: 128px; font-size: 3rem;">
                    <i class="bi bi-person"></i>
                </div>
                }

                <div class="fs-5 mb-1 profile-coquette-text">
                    Пользователь: <strong>@Model.UserLogin</strong>
                </div>
                <div class="small profile-coquette-subtext">
                    ID в системе: <strong>@(Model.UserId > 0 ? Model.UserId : "—")</strong> · Статус: <strong>@Model.RoleTitle</strong>
                </div>
            </div>

            <form method="post" asp-page-handler="UploadAvatar" enctype="multipart/form-data" class="mb-4 border-top pt-3">
                <label asp-for="AvatarFile" class="form-label fw-semibold profile-coquette-text">
                    Загрузить фото профиля
                </label>
                <div class="input-group">
                    <input asp-for="AvatarFile" type="file" accept="image/*" class="form-control" />
                    <button type="submit" class="btn profile-coquette-btn">
                        Загрузить
                    </button>
                </div>
                <div class="form-text profile-coquette-subtext">
                    Форматы: JPG, PNG, WEBP, GIF. Максимальный размер: 2 МБ.
                </div>
            </form>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3">
                <a asp-page="/Index" class="btn profile-coquette-btn rounded-pill px-4">
                    <i class="bi bi-house-door"></i> На главную
                </a>

                <form method="post" asp-page-handler="Logout" class="m-0">
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-right"></i> Выйти
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>